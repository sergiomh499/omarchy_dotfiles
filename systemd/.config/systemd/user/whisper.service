[Unit]
Description=Whisper STT (faster-whisper, CUDA)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sergi/whisper
Environment=WHISPER_MODEL=small
Environment=WHISPER_DEVICE=cpu
Environment=WHISPER_COMPUTE=int8
Environment=WHISPER_LANG=es
Environment=LD_LIBRARY_PATH=/home/sergi/whisper/venv/lib/python3.14/site-packages/nvidia/cublas/lib:/home/sergi/whisper/venv/lib/python3.14/site-packages/nvidia/cuda_nvrtc/lib
ExecStart=/home/sergi/whisper/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
