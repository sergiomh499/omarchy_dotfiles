# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#080201"

# Main text color
theme[main_fg]="#eedff1"

# Title color for boxes
theme[title]="#eedff1"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#6181da"

# Background color of selected item in processes box. #211b1a maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #211b1a gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#211b1a"

# Foreground color of selected item in processes box. Use #eedff1 so
# the row text stays readable on the lighter_bg highlight; the previous
# #6181da produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#eedff1"

# Color of inactive/disabled text
theme[inactive_fg]="#69625f"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #f1e4f3 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #eedff1 directly.
theme[graph_text]="#eedff1"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #211b1a collapsed to the main fg.
theme[meter_bg]="#211b1a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #4fa0ee for a distinct accent instead of #f1e4f3 which capped to white.
theme[proc_misc]="#4fa0ee"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#ad6bbe"
theme[mem_box]="#d17f27"
theme[net_box]="#c65b4a"
theme[proc_box]="#6181da"

# Box divider line and small boxes line color
theme[div_line]="#69625f"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#d17f27"
theme[temp_mid]="#dd8c33"
theme[temp_end]="#c65b4a"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#4fa0ee"
theme[cpu_mid]="#6181da"
theme[cpu_end]="#ad6bbe"

# Mem/Disk free meter
theme[free_start]="#ad6bbe"
theme[free_mid]="#6181da"
theme[free_end]="#4fa0ee"

# Mem/Disk cached meter
theme[cached_start]="#6181da"
theme[cached_mid]="#4fa0ee"
theme[cached_end]="#ad6bbe"

# Mem/Disk available meter
theme[available_start]="#dd8c33"
theme[available_mid]="#c65b4a"
theme[available_end]="#c65b4a"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#d17f27"
theme[used_mid]="#4fa0ee"
theme[used_end]="#6181da"

# Download graph colors
theme[download_start]="#dd8c33"
theme[download_mid]="#c65b4a"
theme[download_end]="#c65b4a"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#d17f27"
theme[upload_mid]="#4fa0ee"
theme[upload_end]="#6181da"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#4fa0ee"
theme[process_mid]="#6181da"
theme[process_end]="#ad6bbe"
