# Ignore sensitive files & credentials
*secret*
*.env.local
.env
.git-credentials
.1Password/
.ssh/
.gnupg/

# Fish runtime state
fish_variables

# Backups and temporary files
*.bak
*.bak.*
*.backup*
.*.backup*
*.omasettings.bak
*.tmp
*.swp
*~

# Build artifacts & caches
__pycache__/
*.pyc
node_modules/
.cache/

# Omarchy cloned plugins and media
omarchy/.config/omarchy/plugins/
omarchy/.config/omarchy/lock-videos/

# Cloned themes (managed by omarchy theme install)
omarchy/.config/omarchy/themes/ghost-pastel/
omarchy/.config/omarchy/themes/lawson-night/
omarchy/.config/omarchy/themes/rose-pine-dark/
omarchy/.config/omarchy/themes/terminus/


